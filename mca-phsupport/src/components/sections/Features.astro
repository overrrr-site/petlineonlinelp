---
---

<section class="section" style="background:var(--background-02)" aria-labelledby="features-title" data-section="feature" data-section-order="4">
  <div class="screen-wrapper">
    <div class="features screen">
      <div class="features__frame">
        <header class="features__title">
          <p class="features__label">REASON</p>
          <h2 class="features__title-jp" id="features-title">3つの特徴</h2>
        </header>

        <!-- 01 -->
        <section class="feat" aria-labelledby="reason-01-title">
          <div class="feat__row">
            <div class="feat__illus feat__illus--dog">
              <img class="feat__img" src="/mca-phsupport/img/feat-ph-balance.svg" alt="尿pHを弱酸性に保つイメージ（酸とアルカリの天秤）" width="205" height="167" loading="lazy" />
              <span class="feat__badge">01</span>
            </div>
            <div class="feat__body">
              <h3 class="feat__h" id="reason-01-title">ストルバイト結石に配慮<br /><span class="feat__h-sub">（マグネシウム由来）</span></h3>
              <p class="feat__text">ミネラルバランスと栄養成分を調整し、下部尿路の健康維持に配慮した設計です。</p>
            </div>
          </div>

          <div class="feat__phbox">
            <div class="feat__ph-col">
              <h4 class="feat__sub">(1)尿pHを意識した設計</h4>
              <p class="feat__sub-text">ミネラル・アミノ酸を調整し、尿を弱酸性に保つ設計です。</p>
              <table class="feat__tbl">
                <tbody>
                  <tr><th>1歳から</th><td>尿pH 6.0〜6.3</td></tr>
                  <tr><th>11歳から</th><td>尿pH 6.2〜6.5</td></tr>
                </tbody>
              </table>
            </div>
            <div class="feat__ph-col">
              <h4 class="feat__sub">(2)マグネシウム含有量を調整</h4>
              <p class="feat__sub-text">マグネシウム含有量を厳密に調整。</p>
              <p class="feat__mg-label">マグネシウム 標準値</p>
              <table class="feat__tbl">
                <tbody>
                  <tr><th>1歳から</th><td>0.1%</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <hr class="feat__divider" />

        <!-- 02 -->
        <section class="feat" aria-labelledby="reason-02-title">
          <div class="feat__row">
            <div class="feat__illus">
              <img class="feat__img" src="/mca-phsupport/img/feat-fish.webp" alt="魚のイラスト" loading="lazy" />
              <span class="feat__badge">02</span>
            </div>
            <div class="feat__body">
              <h3 class="feat__h" id="reason-02-title">下部尿路の健康維持に、<br />DHA・EPA配合</h3>
              <p class="feat__text">魚とフィッシュオイル由来のDHA・EPAを豊富に配合しました。</p>
            </div>
          </div>

          <table class="feat__tbl feat__tbl--wide">
            <tbody>
              <tr><th>1歳から</th><td>2400mg/kg</td></tr>
              <tr><th>11歳から</th><td>2200mg/kg</td></tr>
            </tbody>
          </table>
        </section>

        <hr class="feat__divider" />

        <!-- 03 -->
        <section class="feat" aria-labelledby="reason-03-title">
          <div class="feat__row">
            <div class="feat__illus">
              <img class="feat__img" src="/mca-phsupport/img/feat-zn.webp" alt="亜鉛アミノ酸のイラスト" loading="lazy" />
              <span class="feat__badge">03</span>
            </div>
            <div class="feat__body">
              <h3 class="feat__h" id="reason-03-title">皮膚・被毛の健康維持</h3>
              <p class="feat__text">DHA・EPA、亜鉛アミノ酸複合体を配合し、健康で美しい皮膚や毛づやに貢献。</p>
            </div>
          </div>
          <p class="feat__note">※ 本商品は治療・予防を目的とした商品ではありません。</p>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    position: relative;
    width: 440px;
    height: 959px;
    background-color: var(--background-02);
    overflow: hidden;
  }

  .features__frame {
    position: absolute;
    top: 64px;
    left: 50%;
    transform: translateX(-50%);
    width: 416px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 11px;
  }

  /* Header */
  .features__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .features__label {
    color: var(--orange);
    font-size: var(--font-size-label);
    font-weight: 700;
    letter-spacing: 0.7px;
    line-height: var(--lh-tight);
  }

  .features__title-jp {
    color: var(--brown-amber);
    font-size: var(--font-size-title-xl);
    font-weight: 900;
    letter-spacing: 1.8px;
    margin: 0;
    line-height: var(--lh-display);
  }

  /* Feature block */
  .feat {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .feat__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .feat__illus {
    position: relative;
    width: 108px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 01の天秤SVGは透過（旧 feat-dog.webp は白背景を画像に内包していた）。
     02/03 の白カードと見た目を揃えるため、枠側で白地を用意する。 */
  .feat__illus--dog {
    background-color: var(--white);
    border-radius: 10px;
    /* 天秤は横長なので、02/03（108px角）と白カードの高さを揃えつつ
       上下左右に余白が残るよう padding と画像幅を調整している */
    padding: 12px 0;
    box-sizing: border-box;
  }

  .feat__illus--dog .feat__img {
    width: 80px;
  }

  .feat__img {
    width: 98px;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
  }

  /* 01：番号バッジを左上の角外に寄せ、犬の顔との被りを避ける */
  .feat__illus--dog .feat__badge {
    top: -15px;
    left: -12px;
  }

  .feat__badge {
    position: absolute;
    top: -10px;
    left: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--brown-amber);
    color: var(--white);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feat__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* 改行位置は <br> で固定。最長行は全角11文字のため、
     .feat__body の幅273pxに収まる上限は24px。余白を見て22pxとする。 */
  .feat__h {
    color: var(--brown-amber);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: var(--lh-heading);
    margin: 0;
  }

  .feat__h-sub {
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  .feat__text {
    color: var(--text-dark);
    font-size: var(--font-size-s);
    font-weight: 500;
    line-height: var(--lh-body);
    margin: 0;
  }

  /* 01: cream box with two columns */
  .feat__phbox {
    display: flex;
    gap: 10px;
    background-color: var(--bubble-fill);
    border-radius: 8px;
    padding: 10px;
  }

  .feat__ph-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .feat__sub {
    color: var(--brown-amber);
    font-size: var(--font-size-cell);
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: var(--lh-note);
    margin: 0;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--brown-amber);
  }

  .feat__sub-text {
    color: var(--text-dark);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: var(--lh-note);
    letter-spacing: -0.4px;
    margin: 0;
  }

  .feat__mg-label {
    color: var(--brown-amber);
    font-size: var(--font-size-xs);
    font-weight: 500;
    /* ラベル＋表を列の下端へ寄せ、左列の表と下面を揃える。
       余った空きが本文との間の余白になる。 */
    margin: auto 0 0;
  }

  /* 左列(1)の表も下端アンカーし、両列の表の下面を確実に揃える */
  .feat__phbox > .feat__ph-col:first-child > .feat__tbl {
    margin-top: auto;
  }

  /* Tables */
  .feat__tbl {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4px;
  }

  .feat__tbl th,
  .feat__tbl td {
    border: 1px solid var(--brown-amber);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-align: center;
    padding: 4px 2px;
    line-height: var(--lh-tight);
    white-space: nowrap;
  }

  .feat__tbl th {
    background-color: var(--brown-amber);
    color: var(--white);
    width: 44%;
  }

  .feat__tbl td {
    background-color: var(--white);
    color: var(--brown-amber);
  }

  .feat__tbl--wide {
    margin-top: 0;
  }

  .feat__tbl--wide th {
    width: 44%;
    padding: 6px 2px;
  }

  .feat__tbl--wide td {
    padding: 6px 2px;
  }

  /* Divider */
  .feat__divider {
    border: none;
    border-top: 1.5px dashed var(--brown-amber);
    width: 100%;
    margin: 0;
    opacity: 0.85;
  }

  .feat__note {
    color: var(--text-note);
    font-size: var(--font-size-xs);
    font-weight: 400;
    line-height: var(--lh-note);
    letter-spacing: 0.4px;
    margin: 0;
  }
</style>
