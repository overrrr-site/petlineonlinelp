---
import OfferCTA from '../ui/OfferCTA.astro';
---

<section class="section" style="background:var(--background-02)" aria-labelledby="fv-title" data-section="fv" data-section-order="1">
  <div class="screen-wrapper">
    <div class="fv screen">
      {/* キャッチはFV画像に焼き込まれているため、見出しはテキストとして視覚的に隠して残す。
          SEO と読み上げ、および aria-labelledby="fv-title" の参照先を維持するために必要。 */}
      <h1 class="fv__title-sr" id="fv-title">愛犬にも意外と多い“おしっこ”の悩みをケア。年齢に合わせて選べる2タイプ。</h1>

      <img
        class="fv__hero-image"
        src="/mca-phsupport/img/fv-hero-agepack-880-v2.webp"
        alt="メディコートアドバンス 尿石ケア pHサポート「1歳から（成犬用）」「11歳から（シニア用）」2.5kgのパッケージとフード。お一人様1回限りの限定価格、たっぷり2.5kgが800円（税込）。送料当社負担、自動継続なし。"
        width="880"
        height="1440"
        fetchpriority="high"
      />

      {/* 送料・自動継続の表記はFV画像内に入っているため、ここでは繰り返さず
          「試す前に何を確かめればいいか」を一言で示してCTAへつなぐ。 */}
      <p class="fv__micro">まずは、食いつきを確認。</p>

      <div class="fv__cta">
        {/* 飛び先は申込セクション（最下部）ではなく、3番目の年齢別セクション。
            FVの時点では年齢を選んでいないため商品を決め打ちできず、
            まず年齢を選んでもらってから各商品詳細ページへ直接送る導線にしている。 */}
        <OfferCTA
          lp="phsupport"
          position="fv"
          href="#type"
          ctaRole="scroll_to_type"
          showPrice={false}
          ariaLabel="今すぐ試す（年齢別のタイプを見る）"
        />
      </div>

      <p class="fv__swipe-text">swipe</p>
    </div>
  </div>
</section>

<style>
  .fv {
    position: relative;
    width: 440px !important;
    height: 959px !important;
    background-color: var(--background-02);
    overflow: hidden !important;
    will-change: transform;
  }

  /* 視覚的に隠すが、読み上げ・検索エンジンには残す */
  .fv__title-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* FV画像：キャッチ・商品ビジュアル・価格・保証表記をすべて内包（440×720）。
     背景は透過なので、セクション背景 --background-02 がそのまま地色になる。 */
  .fv__hero-image {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 440px;
    height: 720px;
    object-fit: contain;
  }

  /* CTA以下は、小画面（320×568相当）でも FloatingCTA に隠れないよう詰めてある。
     数値を下げるときは 320×568 で swipe が隠れないか必ず確認すること。 */
  .fv__cta {
    position: absolute;
    top: 745px;
    left: 0;
    width: 440px;
  }

  /* CTAボタンの上に置く一言。画像内の表記と重複させない */
  .fv__micro {
    position: absolute;
    top: 722px;
    left: 58px;
    width: 323px;
    font-weight: 700;
    color: var(--text-note);
    font-size: var(--font-size-xs);
    letter-spacing: 0;
    line-height: 1.25;
    text-align: center;
    font-family: var(--font-family);
  }

  .fv__swipe-text {
    position: absolute;
    top: 811px;
    left: calc(50% - 20px);
    font-family: var(--font-family);
    font-weight: 500;
    color: var(--amber-brown);
    font-size: var(--font-size-xs);
    letter-spacing: 1.2px;
    line-height: 1;
    animation: swipe-bounce 1.6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes swipe-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50%      { transform: translateY(4px); opacity: 1; }
  }
</style>
